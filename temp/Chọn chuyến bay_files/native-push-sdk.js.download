class NativePushSDK {
    constructor() {
        this.partnerName = Insider.partner.name;
        this.localStorage = "storageData";
        this.webPushStorageKey = "ins-wp-storage";
        this.debug = true;
        this.tokenCollectorUrl = "https://carrier.useinsider.com/v2/web-push/token-collector";
        this.hitApiUrl = "https://hit.api.useinsider.com/hit";
        this.swPath = Insider.webPushState.nativeOptInSDKCustomPath
            ? Insider.webPushState.nativeOptInSDKCustomPath
            : "/insider-sw-sdk.js";
        this.VAPIDPublicKey = Insider.webPushState.VAPIDPublicKey;
        this.isVAPIDActive = !Insider.fns.isEmptyString(this.VAPIDPublicKey);
        this.wpLogUrl = "https://wp-log.api.useinsider.com/v2/collect";
        this.STORAGE = {
            PAYLOAD_COMPLETE: "ins-wp-payload-complete",
            TOKEN_CREATE_DATE: "ins-wp-token-create-date",
            MIGRATED_SDK: "ins-wp-migrated-sdk",
            TOKEN: "ins-wp-token",
            REQUEST_SENT: "ins-wp-request-sent",
            NATIVE_PERMISSION_IMPRESSION: "ins-wp-native-permission-impression",
            LOCAL_STORAGE: "localStorage",
            VARIATION_CANDIDATE: "ins-variationCandidate"
        };
        this.tableName = "settings";
        this.hasServiceWorkerSupport = "serviceWorker" in navigator;
        this.hasPush = "PushManager" in window || "push" in navigator;
        this.hasNotification = "Notification" in window;
        this.events = {
            CORE: "nativeSdk:permission:",
            PROMPTED: "prompted",
            GRANTED: "granted",
            DENIED: "denied"
        };
        this.classes = {
            optInNativeDialog: "insider-opt-in-native-dialog",
            optInOverlay: "insider-opt-in-overlay",
            optInOverlayMessage: "insider-opt-in-overlay-message",
            optInInstructionWrapper: "insider-opt-in-instruction-wrapper",
            optInInstruction: "insider-opt-in-instruction",
            optInInstructionClose: "insider-opt-in-instruction-close",
            optInInstructionImage: "insider-opt-in-instruction-image",
            optInInstructionMessage: "insider-opt-in-instruction-message"
        };
        this.lastSwRegistrationError = "lastSwRegistrationError";
        this.campaignStorageNamePrefix = "sp-camp-";
        this.METHODS = {
            INSERT: "insert",
            UPDATE: "update"
        };
        this.PUSH_TYPES = {
            WELCOME: 10
        };
        this.LEAD_COLLECTION = {
            ENDPOINT: `https://carrier.useinsider.com/v2/form/save-questionnaire/${this.partnerName}`,
            REQUEST_HEADERS: {
                partner: this.partnerName,
                "Content-Type": "application/json"
            },
            REQUEST_DATA: {
                form_data: [],
                uid: Insider.getUserId(),
                source: window.location.href,
                platform: Insider.browser.getPlatform()
            }
        };
    }

    initialize() {
        this.debug = this.checkFromStorage("insider-push-debug", true);
        this.initializeIndexedDB((success) => {
            if (success) {
                Insider.indexedDB.save(this.tableName, { id: 1, name: "partnerName", value: this.partnerName });
                Insider.indexedDB.save(this.tableName, { id: 2, name: "spUID", value: Insider.getUserId() });
                Insider.indexedDB.save(this.tableName, { id: 3, name: "lastReceivedWebPushes", value: [] });
            }
        });
        if (this.debug) {
            console.log("Initializing Native SDK");
            console.log("Push Manager Support:", this.hasPush);
            console.log("Notification Support:", this.hasNotification);
        }
        if (this.hasPush && this.hasNotification) {
            if (Insider.browser.name !== "Safari") {
                this.saveImpressionLog();
            }
            this.grantPermission();
        }
        Insider.eventManager.dispatch(this.events.CORE + this.events.PROMPTED);
        return true;
    }

    initializeIndexedDB(callback) {
        Insider.indexedDB.connect("webPush", (success) => {
            if (callback) callback(success);
        });
        return true;
    }

    saveImpressionLog() {
        if (!this.checkFromStorage(this.STORAGE.NATIVE_PERMISSION_IMPRESSION, true)) {
            this.setStorage(this.STORAGE.NATIVE_PERMISSION_IMPRESSION, true, 360);
            new Insider.log("w", {
                t: "storeLog",
                type: "webPush",
                logType: "native-permission-impression",
                browser: Insider.browser.name,
                isMobile: Insider.browser.isMobile(),
                language: Insider.systemRules.call("getLang")
            }).setLogURL(this.wpLogUrl).send();
            return true;
        }
        return false;
    }

    grantPermission() {
        this.appendOverlay();
        this.appendInstructionMessage();
        if (Insider.browser.name === "Safari" && Notification.permission === "granted") {
            this.registerServiceWorker();
            return true;
        }
        Notification.requestPermission().then(this.handlePermissionAction.bind(this));
        return true;
    }

    appendOverlay() {
        if (!window.insiderOptInOverlayIsActive) return false;
        const dialog = Insider.dom().create("div", { id: this.classes.optInNativeDialog });
        dialog.append(Insider.dom().create("div", { className: this.classes.optInOverlay }));
        dialog.append(Insider.dom().create("div", { className: this.classes.optInOverlayMessage }).text(window.insiderOptInOverlayMessage));
        Insider.dom("body").append(dialog);
        Insider.eventManager.on("click", `.${this.classes.optInOverlay}`, this.removeOverlayAndInstruction.bind(this));
        return true;
    }

    appendInstructionMessage() {
        if (!window.insiderOptInInstructionMessageIsActive) return false;
        Insider.dom("body").append(this.getInstructionMessageElement());
        Insider.eventManager.on("click", `.${this.classes.optInInstruction}`, this.removeOverlayAndInstruction.bind(this));
        return true;
    }

    getInstructionMessageElement() {
        const wrapper = Insider.dom().create("div", {
            id: this.classes.optInInstructionWrapper,
            className: this.classes.optInInstruction
        });
        wrapper.append(Insider.dom().create("div", { className: this.classes.optInInstructionClose }));
        wrapper.append(
            Insider.dom().create("div", { className: this.classes.optInInstructionImage })
                .append(Insider.dom().create("img", { src: window.insiderOptInInstructionImage }))
        );
        wrapper.append(
            Insider.dom().create("div", { className: this.classes.optInInstructionMessage })
                .text(window.insiderOptInInstructionMessage)
        );
        return wrapper;
    }

    handlePermissionAction(permission) {
        this.removeOverlayAndInstruction();
        if (window.isRequestPermission || permission === "default") return false;
        if (Insider.browser.name === "Safari") this.saveImpressionLog();
        window.isRequestPermission = true;
        if (permission !== "granted") {
            Insider.eventManager.dispatch(this.events.CORE + this.events.DENIED);
            return false;
        }
        Insider.eventManager.dispatch(this.events.CORE + this.events.GRANTED);
        this.registerServiceWorker();
        return true;
    }

    removeOverlayAndInstruction() {
        if (!window.insiderOptInOverlayIsActive && !window.insiderOptInInstructionMessageIsActive) return false;
        if (window.insiderOptInOverlayIsActive) {
            Insider.dom(`#${this.classes.optInNativeDialog}`).remove();
        }
        if (window.insiderOptInInstructionMessageIsActive) {
            Insider.dom(`#${this.classes.optInInstructionWrapper}`).remove();
        }
        return true;
    }

    registerServiceWorker() {
        navigator.serviceWorker.register(this.swPath)
            .then(this.handleRegistrationEvent.bind(this))
            .catch((err) => {
                const errorMsg = `REGISTRATION_ERROR | Browser: ${Insider.browser.getBrowserNameForWebPushToken()} | Partner: ${this.partnerName} | Error: ${err.message || err.stack}`;
                if (!this.isEqualToLastError(errorMsg)) {
                    this.setLastSwRegistrationError(errorMsg);
                    this.sendLogToTokenCollector(errorMsg);
                }
                this.handleException(err);
            });
        Insider.worker.pm({ type: "unregisterCustomOptInServiceWorker" });
        return true;
    }

    handleException(err) {
        let expireDay = Number(Insider.webPushState.nativeOptInCookieSettings.permissionAbandonExpireDay);
        if (Notification.permission === "denied") {
            expireDay = Number(Insider.webPushState.nativeOptInCookieSettings.permissionBlockExpireDay);
        }
        this.setUserPermissionGranted({ pushRequestSent: true });
        this.setStorage(this.STORAGE.REQUEST_SENT, true, expireDay);
        if (this.debug) console.log(err);
        this.removeOverlayAndInstruction();
        return true;
    }

    handleRegistrationEvent(registration) {
        registration.addEventListener("updatefound", (event) => {
            const installing = event.target.installing;
            installing.addEventListener("statechange", () => {
                if (installing.state === "activated") {
                    this.subscribe(registration);
                }
            });
        });
        this.instantSubscribe(registration);
        return true;
    }

    subscribe(registration) {
        const options = { userVisibleOnly: true };
        if (this.isVAPIDActive) {
            options.applicationServerKey = this.convertVapidKeyToInt8Array();
        }
        registration.pushManager.subscribe(options)
            .then(this.saveSubscription.bind(this))
            .catch((err) => {
                console.log("Error occurred while subscribing existing registration: ", err);
                if (Insider.fns.has(err.message, "applicationServerKey") && this.hasServiceWorkerSupport) {
                    navigator.serviceWorker.getRegistration().then((reg) => {
                        if (!Insider.fns.isUndefined(reg)) {
                            reg.unregister().then(() => {
                                this.register();
                            });
                        }
                    });
                }
            });
        return true;
    }

    saveSubscription(subscription) {
        const subscriptionId = "subscriptionId" in subscription
            ? subscription.subscriptionId
            : this.getSubscriptionId(subscription.endpoint);
        const keys = Insider.fns.parse(Insider.fns.stringify(subscription)).keys || {};
        const auth = keys.auth || "";
        const p256dh = keys.p256dh || "";
        this.setUserPermissionGranted({ insdrSubsId: subscriptionId, pushRequestSent: true });
        Insider.worker.pm({
            type: this.localStorage,
            message: { action: "read" },
            success: function (result) {
                const storage = Insider.fns.find(result, "key", this.webPushStorageKey, true);
                const now = Math.floor(Date.now() / 1000);
                const needsMigration = this.migrationNeeded() || !Insider.fns.isEmptyArray(storage) ||
                    (this.getStorage("unificationUserDataHash") && !this.getStorage("ins-wp-user-unification"));
                if (needsMigration) {
                    if (this.getStorage("unificationUserDataHash") && !this.getStorage("ins-wp-user-unification")) {
                        this.setStorage("ins-wp-user-unification", "true", Insider.dateHelper.addHour());
                    }
                    this.saveSubscriptionId(subscriptionId, auth, p256dh, this.METHODS.UPDATE);
                    this.initializeIndexedDB((success) => {
                        if (success) {
                            Insider.indexedDB.upsert("options", { key: "subscriptionId", value: subscription.endpoint });
                            Insider.indexedDB.upsert("options", { key: "subscriptionUpdateDate", value: now });
                        }
                    });
                } else {
                    const welcomeId = this.getWelcomeTestPushId();
                    this.saveSubscriptionId(subscriptionId, auth, p256dh, this.METHODS.INSERT, welcomeId);
                    this.initializeIndexedDB((success) => {
                        if (success) {
                            Insider.indexedDB.upsert("options", { key: "subscriptionId", value: subscription.endpoint });
                            Insider.indexedDB.upsert("options", { key: "subscriptionCreateDate", value: now });
                            Insider.indexedDB.upsert("options", { key: "subscriptionUpdateDate", value: now });
                        }
                    });
                }
            }.bind(this)
        });
        return true;
    }

    getWelcomeTestPushId() {
        const candidate = Insider.fns.objectValues(Insider.storage.get(this.STORAGE.VARIATION_CANDIDATE))[0];
        if (!candidate) return false;
        const push = Insider.webPush.webPush.getPushById(candidate);
        if (!push || push.otherSettings.pushType !== this.PUSH_TYPES.WELCOME) return false;
        return push.id;
    }

    saveSubscriptionId(token, authToken, p256DH, method, testCampaign = false) {
        const data = {
            token,
            authToken,
            p256DH,
            isNativeOptIn: 1,
            browser: Insider.browser.getBrowserNameForWebPushToken(),
            userId: Insider.getUserId(),
            pageUrl: window.location.href,
            language: Insider.systemRules.call("getLang"),
            partner: this.partnerName,
            method,
            swVersion: Insider.webPush.swVersion
        };
        if (testCampaign) data.testCampaign = testCampaign;
        this.sendRequest({
            url: this.tokenCollectorUrl,
            data,
            headers: { partner: this.partnerName }
        }, () => {
            const expireDay = Number(Insider.webPushState.nativeOptInCookieSettings.permissionAllowExpireDay);
            this.setStorage(this.STORAGE.REQUEST_SENT, true, expireDay);
            this.setStorage(this.STORAGE.PAYLOAD_COMPLETE, true, expireDay);
            this.setStorage(this.STORAGE.TOKEN, token, expireDay);
            this.setStorage(this.STORAGE.MIGRATED_SDK, this.swPath, expireDay);
            this.setStorage(this.STORAGE.TOKEN_CREATE_DATE, Date.now(), expireDay);
            if (method === this.METHODS.INSERT) {
                this.sendOptinTemplatesLeadCollectionLogs();
            }
        });
        return true;
    }

    sendOptinTemplatesLeadCollectionLogs() {
        const campaigns = (Insider.webPush.webPush.optInTemplates || {}).campaigns;
        if (Insider.fns.isEmptyArray(campaigns)) return false;
        campaigns.forEach((campaign) => {
            const id = campaign.id;
            const local = Insider.storage.localStorage.get(`${this.campaignStorageNamePrefix}${id}`);
            if (Insider.fns.isObject(local)) {
                Insider.request.post({
                    url: this.LEAD_COLLECTION.ENDPOINT,
                    headers: this.LEAD_COLLECTION.REQUEST_HEADERS,
                    parse: true,
                    data: Insider.fns.stringify({
                        ...this.LEAD_COLLECTION.REQUEST_DATA,
                        campaign_id: id
                    })
                });
            }
        });
        return true;
    }

    setUserPermissionGranted(message) {
        Insider.fns.pm({ target: window.top, type: "setUserPermissionGranted", message });
        return true;
    }

    getSubscriptionId(endpoint) {
        return endpoint.split("/").pop();
    }

    instantSubscribe(registration) {
        let sw = registration.installing || registration.waiting || registration.active;
        if (!sw || sw.state !== "activated") return false;
        this.subscribe(registration);
        return true;
    }

    migrationNeeded() {
        const payloadComplete = this.checkFromStorage(this.STORAGE.PAYLOAD_COMPLETE, true);
        const customPath = Insider.webPushState.nativeOptInSDKCustomPath && !this.getStorage(this.STORAGE.MIGRATED_SDK) && payloadComplete;
        const tokenExists = !payloadComplete && this.getStorage(this.STORAGE.TOKEN);
        return customPath || tokenExists;
    }

    getStorage(key) {
        return Insider.storage.get(key, this.STORAGE.LOCAL_STORAGE, true);
    }

    setStorage(key, value, expires) {
        Insider.storage.set({ name: key, value, expires }, this.STORAGE.LOCAL_STORAGE, true);
        return true;
    }

    checkFromStorage(key, value) {
        return this.getStorage(key) === value;
    }

    convertVapidKeyToInt8Array() {
        let key = this.VAPIDPublicKey;
        let padded = (key + "=".repeat((4 - key.length % 4) % 4)).replace(/-/g, "+").replace(/_/g, "/");
        let raw = window.atob(padded);
        let arr = new Uint8Array(raw.length);
        for (let i = 0; i < raw.length; ++i) arr[i] = raw.charCodeAt(i);
        return arr;
    }

    sendRequest(options, callback) {
        Insider.request.post({
            url: options.url,
            data: options.data,
            headers: options.headers,
            success: () => (callback || Insider.fns.noop)(),
            error: (err, msg) => {
                if (this.debug) console.log(msg);
                this.handleException(msg);
            }
        });
        return true;
    }

    sendLogToTokenCollector(error) {
        const storage = Insider.storage.get(this.webPushStorageKey);
        this.sendRequest({
            url: this.tokenCollectorUrl,
            headers: {
                "Content-Type": "application/json",
                partner: this.partnerName
            },
            data: Insider.fns.stringify({
                method: "swRegistrationError",
                userId: Insider.getUserId(),
                token: storage ? storage.token : "-",
                language: storage ? storage.language : "-",
                browser: Insider.browser.getBrowserNameForWebPushToken(),
                pageUrl: window.location.href,
                partner: this.partnerName,
                error,
                userAgent: window.navigator.userAgent
            })
        });
        return true;
    }

    isEqualToLastError(error) {
        return Insider.fns.compareAsString(this.getLastSwRegistrationError(), error);
    }

    getLastSwRegistrationError() {
        return Insider.storage.get(this.lastSwRegistrationError) || "";
    }

    setLastSwRegistrationError(error) {
        Insider.storage.set({ name: this.lastSwRegistrationError, value: error, expires: 7 });
        return true;
    }
}

// Initialize the SDK
(new NativePushSDK()).initialize();