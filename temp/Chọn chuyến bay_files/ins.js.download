721618600.png','https://image.useinsider.com/vietnamairlinesnew/defaultImageLibrary/1-%20Ha%CC%80i%20lo%CC%80ng-1721618625.png','https://image.useinsider.com/vietnamairlinesnew/defaultImageLibrary/1-%20Ra%CC%82%CC%81t%20ha%CC%80i%20lo%CC%80ng-1721618654.png']};const textElements={extraReason:`<div class=\"${classes.moreReasonSection}\">\n            <div class=\"${classes.extraText}\">\n                ${textConfig.ratingSurveyTexts.extra}\n            </div>\n        </div>\n        <div class=\"${classes.moreReasonSection}\">\n            <textarea class=\"${classes.ratingInput}\" style=\"height: 100px!important;\"></textarea>\n        </div>`,reasonSection:`<div class=\"${classes.reasonSection}\">\n            <span>${textConfig.ratingSurveyTexts.reason}</span>\n        </div>\n        <div class=\"${classes.reasonSection}\">\n            <div class=\"${classes.optionText}\">\n                <input class=\"${classes.optionCheckbox}\" type=\"checkbox\">\n                <div>${textConfig.reasonTexts.reason1}</div>\n            </div>\n            <div class=\"${classes.optionText}\">\n                <input class=\"${classes.optionCheckbox}\" type=\"checkbox\">\n                <div>${textConfig.reasonTexts.reason2}</div>\n            </div>\n            <div class=\"${classes.optionText}\">\n                <input class=\"${classes.optionCheckbox}\" type=\"checkbox\">\n                <div>${textConfig.reasonTexts.reason3}</div>\n            </div>\n            <div class=\"${classes.optionText}\">\n                <input class=\"${classes.optionCheckbox}\" type=\"checkbox\">\n                <div>${textConfig.reasonTexts.reason4}</div>\n            </div>\n            <div class=\"${classes.optionText}\">\n                <input class=\"${classes.optionCheckbox}\" type=\"checkbox\">\n                <div>${textConfig.reasonTexts.reason5}</div>\n            </div>\n            <div class=\"${classes.optionText}\">\n                <input class=\"${classes.optionCheckbox}\" type=\"checkbox\">\n                <div>${textConfig.reasonTexts.other}</div>\n            </div>\n        </div>`,successMessage:`<div class=\"${classes.successMessage}\">\n            ${textConfig.successMessageText}\n        </div>`,notificationPermission:`<div class=\"${classes.notificationText}\">\n            ${textConfig.notificationText}\n            <a href=\"${textConfig.notificationUrl}\">${textConfig.notificationRedirectText}</a>\n        </div>`};self.init=()=>{if(variationId&&!Insider.storage.localStorage.get(submitGoalStore)){if(!Insider.campaign.isControlGroup(variationId)){setTimeout(()=>{self.reset();self.addCss();self.addRatingSurveyHtml();self.setInitialBackgrounds();self.addClickEvents()},1e3)}return true}};self.reset=()=>{const{yesNoSurveyWrapper,emailWrapper,ratingWrapper,style}=selectors;Insider.dom(`${yesNoSurveyWrapper}, ${ratingWrapper}, ${emailWrapper}, ${style}`).remove()};self.addCss=()=>{const{smoothScroll:smoothScrollClass,style:styleClass}=classes;const{mascotRating,successMessage:successMessageSelector,reasonSection:reasonSectionSelector,optionText,optionCheckbox,moreReasonSection,extraText,ratingInput,smoothScroll,yesNoSurveyWrapper,yesNoSurveyContent,yesNoSectionWrapper,yesChoice,noChoice,ratingWrapper,ratingContainer,emailWrapper,emailContent,header,ratingText,ratingQuestion,ratingButton,ratingNumber,ratingValueWrapper,ratingContent,satisfiedDegree,ratingButtonWrapper,notificationText}=selectors;const style=`\n        ${successMessageSelector} {\n            font-size: 18px !important;\n            color: #0582a6;\n            padding-bottom: 40px !important;\n            text-align: center;\n            display: none;\n        }\n        ${reasonSectionSelector} {\n            display: flex;\n            justify-content: space-between;\n        }\n        ${reasonSectionSelector} span {\n            font-size: 20px;\n            font-family: inherit;\n            text-align: center;\n            width: 100%;\n            margin: 15px;\n        }\n        ${optionText} {\n            text-align: center;\n            font-size: ${isMobile?'12px':'13px'}!important;\n            flex-basis: 20%;\n            margin: 0 2px !important;\n        }\n        ${optionCheckbox} {\n            width: 25px;\n            height: 25px;\n        }\n        ${moreReasonSection} {\n            margin-top: 20px;\n            display: flex;\n            justify-content: center;\n        }\n        ${extraText} {\n            font-size: 18px !important;\n            font-family: inherit;\n            text-align: center;\n        }\n        ${ratingInput} {\n            resize: none;\n            width: 75%;\n            height: 100px;\n            max-height: 100px;\n        }\n        ${smoothScroll} {\n            scroll-behavior: smooth;\n        }\n        ${yesNoSurveyWrapper} {\n            padding-bottom: 60px;\n        }\n        ${yesNoSurveyContent} {\n            color: #0582a6;\n            font-family: inherit;\n            text-align: center;\n        }\n        ${yesNoSectionWrapper} {\n            display: flex;\n            justify-content: center;\n            padding: 10px;\n        }\n        ${yesChoice}, ${noChoice} {\n            cursor: pointer;\n            background-color: transparent !important;\n            color: #dba510 !important;\n            border: 1px solid;\n            width: max-content;\n            padding: 5px;\n            margin: 0 5px;\n            border-radius: 10px;\n        }\n        ${yesChoice}:hover, ${noChoice}:hover {\n            background-color: #dba510 !important;\n            color: #ffffff !important;\n        }\n        ${ratingWrapper} {\n            scroll-margin-top: 30vw;\n            background-color: transparent !important;\n            margin:  ${isMobile?'0 6px':'0 auto'}!important;\n\t\t\tdisplay: flex;\n\t\t\tflex-direction: column;\n        }\n        ${ratingContainer} {\n            font-size: 20px;\n            margin-top: 20px;\n            display: flex;\n            justify-content: center;\n            text-align: center;\n        }\n        ${emailWrapper} {\n            background: #f7f0de !important;\n            display: none;\n            padding-bottom: 40px !important;\n        }\n        ${emailContent} {\n            text-align: center;\n        }\n        ${header} {\n            text-align: center;\n            font-size: 24px;\n            font-family: inherit;\n        }\n        ${ratingText} {\n            color: transparent;\n            margin-top: 50%;\n            font-size: 24px;\n            font-family: inherit;\n        }\n        ${ratingQuestion} {\n            font-size: 18px;\n            font-family: inherit;\n        }\n        ${ratingInput} {\n            border-radius: 5px;\n            border-width: 1px;\n        }\n        ${ratingButton} {\n            padding: ${Insider.fns.hasParameter('/uu-dai-thang')?'12px;':'8px;'}\n            color: white;\n            background-color: #166987;\n            border-radius: 5px;\n            height: auto;\n            margin-top: 20px;\n            cursor: pointer;\n        }\n        ${ratingNumber} {\n            width: 100%;\n            display: flex;\n            justify-content: center;\n            line-height: 40px;\n        }\n        ${ratingValueWrapper} {\n            width: 100%;\n            justify-content: center;\n            display: flex;\n        }\n        ${ratingContent} {\n            display: flex;\n            flex-direction: column;\n            width: 100% !important;\n            margin: 0 auto;\n        }\n        ${mascotRating} {\n            cursor: pointer;\n            background-size: cover;\n            background-repeat: no-repeat;\n            max-width: 95px;\n            width: 15vw;\n            min-height: 85px;\n            margin: 10px 0;\n            background-position: center;\n            opacity: 1;\n            transition: opacity 1s ease-in-out;\n            text-align: center;\n            flex-basis: 20%;\n        }\n        ${satisfiedDegree} {\n            width: 15vw;\n            font-size: 13px !important;\n            flex-basis: 20%;\n            visibility: hidden;\n            text-align: center;\n            max-width: 95px !important;\n        }\n        ${ratingButtonWrapper} {\n            display: none;\n            width: max-content;\n            margin: 0 auto 15px auto !important;\n            justify-content: center !important;\n        }\n        ${notificationText} {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n\t\t\tmargin-top: 10px;\n        }\n        ${notificationText} a {\n            text-decoration: none !important;\n            color: #00607d;\n            margin-left: 5px;\n        }\n        @media screen and (max-width: 500px) {\n            ${notificationText} {\n                display: unset;\n                text-align: center !important;\n                float: left !important;\n\t\t\t\tmargin-top: 10px;\n            }\n        }`;Insider.dom('html').addClass(smoothScrollClass);Insider.dom('<style>').addClass(styleClass).html(style).appendTo('head')};self.addRatingSurveyHtml=()=>{const{ratingValueWrapper,veryLowRating,lowRating,normalRating,goodRating,parallax,ratingWrapper,veryGoodRating,satisfiedDegree,clickGoalClass,ratingContent,ratingNumber,ratingContainer,ratingText,mascotRating,ratingButtonWrapper,ratingButton}=classes;const{degreeOfPointTexts,ratingSurveyTexts:{header,button}}=textConfig;const{veryLowPoint,lowPoint,normalPoint,goodPoint,veryGoodPoint}=degreeOfPointTexts;const ratingNumberElement=backgroundUrls.normal.map((_,index)=>`\n            <div class=\"${clickGoalClass} ${mascotRating}\">\n                <span class=\"${ratingText}\">${index}</span>\n            </div>\n        `).join('');const ratingSurveyDiv=`<div id=\"ins-mascot-rating-${variationId}\" class=\"${parallax} ${ratingWrapper}\">\n         