tionalRule:[8438],isRelational:!1},8672:{test:'window.location.href.indexOf("booking.vietnamairlines.com/booking/payment")>-1&&Insider.rules.call("8674")===true&&(Insider.targetingModules.deviceDetect("Mobil")===false&&Insider.targetingModules.deviceDetect("Tablet")===false);',relationalRule:[8674],isRelational:!1},8674:{test:"const builderId=12359;const variationId=Insider.campaign.userSegment.getActiveVariationByBuilderId(builderId);const camp=Insider.campaign.get(variationId)||{};const ps=camp.ps||camp.pageSettings||{};const locationConfig=ps.locationConfig||{};locationConfig.pe.w.se='.mat-expansion-panel-header-title img[alt*=Momo]';locationConfig.pe.m.se='.mat-expansion-panel-header-title img[alt*=Momo]';locationConfig.pe.t.se='.mat-expansion-panel-header-title img[alt*=Momo]';locationConfig.pe.w.ia='after';locationConfig.pe.m.ia='after';locationConfig.pe.t.ia='after';true;",relationalRule:[],isRelational:!1},8715:{test:"(self=>{'use strict';const isDesktop=Insider.browser.isDesktop();const builderId=isDesktop?12372:12392;const variationId=Insider.campaign.userSegment.getActiveVariationByBuilderId(builderId);const isControlGroup=Insider.campaign.isControlGroup(variationId);const isVariationDefined=!Insider.fns.isUndefined(variationId);const classes={style:`ins-custom-style-${variationId}`,wrapper:`ins-custom-wrapper-${variationId}`};const selectors=Object.keys(classes).reduce((createdSelector,key)=>(createdSelector[key]=`.${classes[key]}`,createdSelector),{konbiniText:'.pnr-on-hold-booking-cancelled-message',konbiniImage:'[alt=\"global.methods-of-payment.Konbini-conv\"]',sevenEleven:'[alt=\"global.methods-of-payment.Konbini-7-11\"]',paymentContainer:'.mat-accordion.accordion',paymentCard:'.payment-section-card .mat-expansion-panel-header'});const content={en_US:`- Please DO NOT select Konbini in \"Manage your booking\" flow, otherwise the ticket might not be issued.<br>\n            - After select Konbini in \"Booking\" flow, you will be re-directed to the Adyen payment gateway page, please enter the information, save the Order code and phone number for payment in Konbini.<br>\n            - Please note that if you go to the Konbini after 24hours, the record will be automatically canceled and you will not be able to pay.<br>\n            - Duplicate bookings (dup at passenger names and segments) are not allowed. In the case, Vietnam Airlines will keep only 1 active reservation. Other reservations will be canceled within 4 hours.<br>\n\t\t\t- This payment method is unavailable for tickets with departure dates less than 3 days from the booking date.<br>\n            - After completing the payment, please do not reload the browser or click the 'Back' button on the redirection page. Thank you!<br><br>\nPayment at Konbini applies to transactions with value under 300,000 JPY. If the passenger's transaction is greater than 300,000 JPY, please select other payment methods available at the payment page`,de_DE:`- Bitte wählen Sie nicht die Konibi-Zahlungsmethode im „Buchung verwalten“-Bereich aus. Wenn Sie Konbini hier wählen, könnte das Ticket möglicherweise nicht ausgestellt werden.<br>\n            - Wenn Sie Konbini im „Ticket kaufen“ auswählen, werden Sie zur Zahlungsplattform des Partners Adyen weitergeleitet, bitte geben Sie dort die Information ein, speichern Sie die Bestellnummer und geben Sie die Telefonnummer für die Zahlung ein.<br>\n            - Bitte zahlen Sie innerhalb 24 Stunden nach der Buchung. Nach Ablauf ist Ihre Reservierung ungültig. Vietnam Airlines beschränkt die Doppelbuchung auf demselben Flug. Bei Doppelbuchung behält Vietnam Airlines nur eine Reservierung bei. Andere Buchungen werden innerhalb von 4 Stunden storniert.<br>\n\t\t\t- Für Tickets mit Abflugdatum innerhalb von 3 Tagen nach der Buchung ist diese Zahlungsmethode nicht verfügbar.<br><br>\nDie Zahlung bei Konbini gilt für Transaktionen unter JPY 300.000. Wenn Ihre Transaktion mehr als JPY 300.000 beträgt, wählen Sie bitte eine andere Zahlungsmöglichkeit.`,fr_FR:`- Veuillez ne pas choisir le paiement par Konbini à la rubrique \"Gérer les réservations\". Si vous choisissez Konbini à cette rubrique, le billet pourrait ne pas être émis.<br>\n            - Lorsque vous choisissez Konbini à la rubrique \"Acheter un billet\", vous serez redirigé vers la page de notre partenaire de paiement, Adyen. Veuillez saisir vos informations, enregistrer le code de commande et le numéro de téléphone pour le paiement.<br>\n            - Veuillez effectuer le paiement dans les 24 heures suivant la réservation. Passé ce délai, votre réservation expirera. Vietnam Airlines limite votre réservation en double sur le même vol. Le cas échéant, Vietnam Airlines ne conservera qu'une seule réservation. Les autres réservations seront annulées dans les 4 heures.<br>\n\t\t\t- Ce mode de paiement n'est pas disponible pour les billets dont le départ est prévu dans les 3 jours suivant la réservation.<br><br>\nLe paiement chez Konbini s'applique aux transactions inférieures à 300 000 JPY. Si votre transaction dépasse 300 000 JPY, veuillez choisir un autre mode de paiement.`,ja_JP:`- 予約の管理」でKonbiniでの支払いを選択しないでください。予約の管理メニューでKonbiniを選択すると、航空券が発行されない場合があります。<br>\n            - 「航空券のご購入」でKonbiniを選択すると、パートナーのAdyenのページにリダイレクトされます。情報を入力し、支払い用の注文コードと電話番号を保存<br>\n            - ご予約から24時間以内にお支払いください。この時間を過ぎると予約は期限切れとなり、ベトナム航空は同じフライトでの重複予約を制限しています。予約が重複した場合、ベトナム航空は１つの予約のみを保持します。その他のご予約は4時間内にキャンセルされます。<br>\n\t\t\t- '予約日から3日以内に出発する航空券には、この支払い方法が適用されません。<br>\n            - お支払い完了後は、ブラウザの更新や「戻る」ボタンをクリックしないでください。ご協力ありがとうございます!<br><br>\nコンビニでのお支払いは30万円以下のお取引が対象となります。お取引金額が30万円を超える場合は、別のお支払い方法を選択してください。`,ko_KR:`- 예약 관리 스레드에서 Konbini로 결제하기를 선택하지 마세요. 이 스레드에서 Konbini를 선택하면 티켓이 발급되지 않을 수 있습니다.<br>\n            - '티켓 구매' 스레드에서 Konbini를 선택하면 결제 게이트웨이 파트너인 Adyen의 페이지로 리디렉션됩니다. 정보를 입력하고 결제를 위한 주문 코드와 전화번호를 저장하세요.<br>\n            - 예약 후 24 시간 이내에 지불하십시오. 이 시간 이후에는 예약이 만료되며, 베트남항공에서는 동일한 항공편에 대한 중복 예약을 제한하고 있습니다. 중복된 예약이 있는 경우 베트남항공은 1개의 예약만 유지합니다. 다른 예약은 4시간 이내에 취소됩니다.<br>\n\t\t\t- '예약일로부터 3일 이내에 출발하는 티켓의 경우 해당 결제 방법을 사용할 수 없습니다.<br><br>\n코비니에서의 결제는 300,000엔 미만의 거래에 적용됩니다. 거래 금액이 JPY 300,000 이상인 경우 다른 결제 방법을 선택해 주세요.`,ru_RU:`- Пожалуйста, не выбирайте оплату Konbini в потоке \"Ваш перелет\". Если вы выберете Konbini на этом потоке, билеты могут не быть выданы.<br>\n            - При выборе Konbini в потоке «Бронирование» вы будете перенаправлены на страницу партнера платежного шлюза Adyen. Введите свои данные, сохраните код заказа и номер телефона для оплаты.<br>\n            - Пожалуйста, оплатите в течение 24 часов после бронирования. По истечении этого времени срок действия вашего бронирования истечет. Vietnam Airlines запрещают вам делать дублирующие бронирования на один и тот же рейс. При наличии дубликата Vietnam Airlines сохраняет только 1 бронирование. Другие заказы будут отменены в течение 4 часов.<br>\n\t\t\t- Билеты с датой вылета в течение 3 дней с момента бронирования не подлежат оплате этим способом.<br><br>\nОплата в Конбини применяется к транзакциям на сумму менее 300,000 JPY. Если сумма вашей транзакции превышает 300,000 JPY, выберите другую форму оплаты.`,vi_VN:`Vui lòng không chọn thanh toán bằng Konbini tại luồng \"Quản lý đặt chỗ\". Nếu Quý khách chọn Konbini tại luồng này, vé có thể không được xuất.<br>\n            - Khi chọn Konbini tại luồng \"Mua vé\", Quý khách sẽ được điều hướng sang trang của đối tác cổng thanh toán Adyen, vui lòng nhập thông tin, lưu Mã đơn hàng và số điện thoại để thanh toán.<br>\n            - Quý khách vui lòng thanh toán trong vòng 24 giờ kể từ khi đặt chỗ. Sau thời gian này, đặt chỗ của quý khách sẽ hết hiệu lực.Vietnam Airlines hạn chế việc Quý khách đặt chỗ trùng lặp trên cùng một chuyến bay. Nếu trùng, Vietnam Airlines sẽ chỉ giữ lại 1 đặt chỗ duy nhất. Các đặt chỗ khác sẽ bị hủy trong vòng 4 tiếng.<br>\n\t\t\t- Vé có ngày khởi hành trong vòng 3 ngày kể từ ngày đặt chỗ sẽ không được áp dụng hình thức thanh toán này.<br>\n            - Sau khi đã hoàn tất thanh toán, Quý khách vui lòng không tải lại trình duyệt hoặc bấm nút \"Quay lại\" trên trang điều hướng. Xin cảm ơn!<br><br>\nThanh toán tại Konbini áp dụng cho các giao dịch dưới 300.000 JPY. Nếu giao dịch của Quý khách lớn hơn 300.000 JPY, vui lòng lựa chọn hình thức thanh toán khác.`,'zh-cn':`-请不要在”管理预订”中选择使用 Konbini 付款。如果您在此部分选择 Konbini，机票则可能不会开具。<br>\n            - 在”预定”中选择 Konbini 时，您将被导向到支付网关合作伙伴 Adyen 的页面，请输入您的信息，储存您的订单代码和付款电话号码。<br>\n            - 在”预定”中选择 Konbini 时，您将被导向到支付网关合作伙伴 Adyen 的页面，请输入您的信息，储存您的订单代码和付款电话号码。<br>\n\t\t\t- 航班出发日期在预订日期起3天内的机票不适用于此付款方式。<br><br>\n在Konbini付款适用于300,000日元以下的交易。如果您的交易金额超过 300,000 日元，请选择其他付款方式。`,zh_tw:`- 請不要在”管理我的訂位”中選擇使用 Konbini 付款。如果您在此部分選擇 Konbini，機票則可能不會開具。<br>\n            - 在”預訂”中選擇 Konbini 時，您將被導向到支付網關合作夥伴 Adyen 的頁面，請輸入您的訊息，儲存您的訂單代碼和付款電話號碼。<br>\n            - 請您在預訂後24小時內付款。在此時間之後，您的預訂將過期。越南航空公司限制您在同一航班上重複預訂。如果有重複預訂，越南航空將僅保留 1 個預訂。其他預訂將在 4 小時內取消。<br>\n\t\t\t- '航班出發日期在預訂日期起3天內的機票不適用於此付款方式。<br><br>\n在Konbini付款適用於300,000日元以下的交易。如果您的交易金額超過 300,000 日元，請選擇其他付款方式。`}[Insider.systemRules.getLang()];const clickEvent=Insider.browser.isDesktop()?'mouseup':'touchend';self.init=()=>{if(!isControlGroup&&isVariationDefined){self.reset();self.buildCSS();self.buildHTML();self.setEvents()}};self.reset=()=>{const{konbiniImage,konbiniText,paymentContainer,sevenEleven}=selectors;Insider.dom(konbiniImage).parents(paymentContainer).find(konbiniText).removeClass(classes.wrapper);Insider.dom(sevenEleven).parents(paymentContainer).find(konbiniText).removeClass(classes.wrapper)};self.buildCSS=()=>{const customStyle=`${selectors.wrapper} {\n            display: flex;\n        }`;Insider.dom('<style>').addClass(classes.style).html(customStyle).appendTo('head')};self.buildHTML=()=>{const{konbiniImage,konbiniText,paymentContainer,wrapper,sevenEleven}=selectors;Insider.fns.onElementLoaded(konbiniText,()=>{Insider.dom(konbiniImage).parents(paymentContainer).find(konbiniText).addClass(classes.wrapper);Insider.dom(sevenEleven).parents(paymentContainer).find(konbiniText).addClass(classes.wrapper);Insider.dom(wrapper).html(content)}).listen()};self.setEvents=()=>{Insider.fns.onElementLoaded(selectors.paymentCard,()=>{Insider.eventManager.once(`${clickEvent}.custom:${variationId}`,selectors.paymentCard,()=>{setTimeout(()=>{self.buildHTML()},500)})}).listen()};self.init()})({});true;",relationalRule:[],isRelational:!1},8716:{test:'window.location.href.indexOf("/booking/payment")>-1&&Insider.rules.call("8715")===true;',relationalRule:[8715],isRelational:!1},8717:{test:'window.location.href.indexOf("/booking/payment")>-1&&Insider.rules.call("8715")===true;',relationalRule:[8715],isRelational:!1},8877:{test:"(self=>{'use strict';const isDesktop=Insider.browser.isDesktop();const builderId=isDesktop?12565:12566;const variationId=Insider.campaign.userSegment.getActiveVariationByBuilderId(builderId);const isControlGroup=Insider.campaign.isControlGroup(variationId);const isVariationDefined=!Insider.fns.isUndefined(variationId);const selectors={operatingAircraft:'.seg-operating-aircraft',initeryDetail:'.itin-details-link'};self.init=()=>{if(!isControlGroup&&isVariationDefined){self.setEvents();self.updateText()}};self.setEvents=()=>{const clickEvent=isDesktop?'mouseup':'touchend';Insider.fns.onElementLoaded(selectors.initeryDetail,()=>{Insider.eventManager.once(`${clickEvent}.ins:click:${variationId}`,selectors.initeryDetail,()=>{self.updateText()})}).listen()};self.updateText=()=>{Insider.fns.onElementLoaded(selectors.operatingAircraft,()=>{Insider.dom(selectors.operatingAircraft).accessNodes(node=>{const elementText=Insider.dom(node).text().trim();if(elementText.includes('AIRBUS A350-900')){Insider.dom(node).text('AIRBUS A350')}else if(elementText.includes('787  ALL SERIES PASSENGER')){Insider.dom(node).text('Boeing 787')}else if(elementText.includes('AIRBUS INDUSTRIE A350')){Insider.dom(node).text('AIRBUS A350')}})}).listen()};self.init()})({});true;",relationalRule:[],isRelational:!1},8878:{test:'window.location.href.indexOf("/booking/availability")>-1&&Insider.rules.call("8877")===true;',relationalRule:[8877],isRelational:!1},8879:{test:'window.location.href.indexOf("/booking/availability")>-1&&Insider.rules.call("8877")===true;',relationalRule:[8877],isRelational:!1},9033:{test:'window.location.href.indexOf("https://booking.vietnamairlines.com/booking/availability-complex")>-1&&Insider.rules.call("9034")===true;',relationalRule:[9034],isRelational:!1},9034:{test:"(self=>{'use strict';const isDesktop=Insider.browser.isDesktop();const builderId=isDesktop?12720:12721;const variationId=Insider.campaign.userSegment.getActiveVariationByBuilderId(builderId);const isControlGroup=Insider.campaign.isControlGroup(variationId);const isVariationDefined=!Insider.fns.isUndefined(variationId);const classes={style:`ins-custom-style-${variationId}`,wrapper:`ins-custom-wrapper-${variationId}`,text:`ins-custom-text-${variationId}`,cta:`ins-custom-cta-${variationId}`,hide:`ins-display-none-${variationId}`,goal:`sp-custom-${variationId}-1`};const selectors=Object.keys(classes).reduce((createdSelector,key)=>(createdSelector[key]=`.${classes[key]}`,createdSelector),{selectElement:'.characteristic[data-characteristic-id=\"refund\"]'});self.init=()=>{if(!isControlGroup&&isVariationDefined){Insider.fns.onElementLoaded(selectors.selectElement,()=>{setTimeout(()=>{self.reset();self.buildCSS();self.buildHTML();self.setEvents()},100)}).listen()}};self.reset=()=>{Insider.dom(`${selectors.style}, ${selectors.wrapper}`).remove()};self.buildCSS=()=>{const{wrapper,hide,text,cta}=selectors;const customStyle=`${wrapper} {\n            display: flex;\n            flex-direction: column;\n        }\n        ${text} {\n            display: flex;\n        }\n        ${cta} {\n            display: flex;\n            color: green !important;\n            font-style: italic;\n            cursor: pointer;\n            font-size: 1.2rem;\n            font-weight: 400;\n            line-height: 1.8rem;\n            font-family: OpenSans-Regular;\n            letter-spacing: normal;\n            margin: 20px 0;\n            text-decoration: underline;\n        }\n        ${hide} {\n            display: none !important;\n        }`;Insider.dom('<style>').addClass(classes.style).html(customStyle).appendTo('head')};self.buildHTML=()=>{const{wrapper,hide,cta,goal}=classes;const buttonConfig={vi_VN:['Tuân thủ điều kiện của từng chặng bay','Chi tiết','https://www.vietnamairlines.com/vn/vi/buy-tickets-other-products/fare-conditions/fare-types'],en_US:['Comply with the conditions of each flight','See more benefits','https://www.vietnamairlines.com/vn/en/buy-tickets-other-products/fare-conditions/fare-types'],ja_JP:['各フライトのルールを遵守する','その他の特典を確認する','https://www.vietnamairlines.com/jp/ja/buy-tickets-other-products/fare-conditions/fare-types'],'zh-cn':['遵守每个航班的条件','查看更多優惠','https://www.vietnamairlines.com/cn/zh/buy-tickets-other-products/fare-conditions/fare-types'],zh_tw:['遵守每個航班的條件','查看更多权益','https://www.vietnamairlines.com/tw/zh-tw/buy-tickets-other-products/fare-conditions/fare-types'],fr_FR:['Respecter les conditions de chaque vol','Voir d\\'autres avantages','https://www.vietnamairlines.com/fr/fr/buy-tickets-other-products/fare-conditions/fare-types'],de_DE:['Beachten Sie die Bedingungen jedes Fluges','Weitere Vorteile anzeigen','https://www.vietnamairlines.com/de/de/buy-tickets-other-products/fare-conditions/fare-types'],ru_RU:['Соблюдение условий каждого рейса','См. дополнительные преимущества','https://www.vietnamairlines.com/ru/ru/buy-tickets-other-products/fare-conditions/fare-types'],ko_KR:['각 항공편의 조건을 준수합니다.','더 많은 혜택 보기','https://www.vietnamairlines.com/kr/ko/buy-tickets-other-products/fare-conditions/fare-types']}[Insider.systemRules.call('getLang')];const buttonHtml=`<div class=\"${wrapper} ${goal}\">\n            <a href=\"${buttonConfig[2]}\" class=\"${cta}\" target=\"_blank\">${buttonConfig[1]}\n                <i aria-hidden=\"true\" class=\"refx-icon-external-link\"></i>\n            </a></div>`;Insider.dom('.characteristic[data-characteristic-id=\"refund\"] .characteristic-value').text(buttonConfig[0]);Insider.dom('.characteristic[data-characteristic-id=\"change\"] .characteristic-value').text(buttonConfig[0]);Insider.dom('.price-card-characteristics-links-wrapper').addClass(hide).after(buttonHtml)};self.setEvents=()=>{Insider.eventManager.once(`click.change:language:${variationId}`,'.mat-focus-indicator.mat-menu-item',()=>{setTimeout(()=>{self.reset();self.buildHTML();self.buildCSS()},200)})};self.init()})({});true;",relationalRule:[],isRelational:!1},9035:{test:'window.location.href.indexOf("https://booking.vietnamairlines.com/booking/availability-complex")>-1&&Insider.rules.call("9034")===true;',relationalRule:[9034],isRelational:!1},9051:{test:"window.location.href.indexOf(\"/jp/vi/\")>-1&&Insider.systemRules.call('isOnMainPage')===true;",relationalRule:[],isRelational:!1},9052:{test:'Insider.segmentModules.newReturningUser("new")===true;',relationalRule:[],isRelational:!1},9315:{test:'Insider.rules.call("7661")===true;',relationalRule:[7661],isRelational:!1},9400:{test:'window.location.href.indexOf("https://booking.vietnamairlines.com/booking/shopping-cart")>-1&&Insider.rules.call("9742")===false&&Insider.rules.call("9401")===true;',relationalRule:[9742,9401],isRelational:!1},9401:{test:"(self=>{'use strict';const isDesktop=Insider.browser.isDesktop();const builderId=isDesktop?13087:13088;const variationId=Insider.campaign.userSegment.getActiveVariationByBuilderId(builderId);const isControlGroup=Insider.campaign.isControlGroup(variationId);const isVariationDefined=!Insider.fns.isUndefined(variationId);const actionType=isDesktop?'pointerup':'touchend';self.init=()=>{if(isVariationDefined){Insider.fns.onElementLoaded('#ph-refx-booking-service-catalog-cont-top',()=>{self.changePlacement();self.sendGoal()}).listen()}};self.sendGoal=()=>{Insider.eventManager.once(`${actionType}.goal:buton:${variationId}`,`.sp-goal-${variationId}-1`,e=>{const goalId=Insider.dom(e._