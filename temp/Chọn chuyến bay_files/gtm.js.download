ZyM0Num3C9rqG8\" type=\"text\/gtmscript\"\u003E\u003C\/script\u003E\n    \u003Cstyle\u003E\n        .custom-button {\n            background-color: #E6B441; \/* Màu nền vàng *\/\n            color: #005F6E;           \/* Màu chữ xanh *\/\n            border: none;             \/* Không viền *\/\n            padding: 10px 20px;       \/* Đệm xung quanh nội dung của nút *\/\n            font-size: 16px;          \/* Cỡ chữ *\/\n            border-radius: 5px;       \/* Bo góc của nút *\/\n            cursor: pointer;          \/* Hiển thị con trỏ như là có thể click *\/\n            transition: background 0.3s, color 0.3s; \/* Hiệu ứng chuyển màu nền và chữ *\/\n            position: fixed;  \/* Cố định nút ở vị trí mong muốn khi cuộn trang *\/\n            top: 30%;   \n            left: 20px;       \/* Cách lề trái 20px *\/\n            z-index: 99;\n            transform: translateY(-50%);\n            font-weight: bold;\n        }\n        .custom-button:hover {\n            background-color: #f7c767; \/* Màu nền khi di chuột *\/\n            color: #007b91;            \/* Màu chữ khi di chuột *\/\n        }\n      .container-gms-farealert {\n            background-color: #80a4c7;\n            font-family: 'Open Sans', sans-serif;\n            font-weight: 400;\n            border-radius: 30px;\n            position: fixed;  \n            height: 345px;\n            left: 50%;\n            top: 50%;\n            width : 800px;\n            transform: translate(-50%, -50%);\n            background:white;\n            z-index:10;\n            box-shadow:0 0 10px rgba(0,0,0,0.3);\n        }\n\n        .left-panel{\n            background-color: #0C6F8C;\n            border-radius: 30px 0 0 30px;\n            position: absolute;\n            left: 0px; \n            top: 0px;\n            width: 265px;\n            height: 345px;\n        }\n\n        .right-panel{\n            background-color: #FFFFFF;\n            border-radius: 0 30px 30px 0;\n            position: absolute;\n            left: 265px;\n            top: 0px;\n            width: 535px;\n            height: 345px;\n        }\n\n        .form-alert{\n            padding: 50px 50px 50px 50px;\n        }\n\n        .left-panel-content{\n            padding: 50px 50px 50px 50px;\n        }\n        .input-field{\n            box-sizing: border-box;\n            display: flex;\n            flex-direction: row;\n            align-items: center;\n            padding: 0px 0px 0px 5px;\n            height: 32px;\n            background: #FFFFFF;\n            border-bottom: 1px solid #D1D3D6;\n            flex: none;\n            flex-grow: 0;\n        }\n      .cross-icon{\n        background-color: #FFD700; \n        color: black; \n        border: 3px solid #FFD700; \n        border-radius: 50%;\n        width: 25px; \n        height: 25px; \n        display: flex;\n        align-items: center;\n        justify-content: center;\n        cursor: pointer;\n        transition: background-color 0.3s ease;\n        font-size: 16px;\n        font-weight: bold;\n      }\n      .cross-icon:hover {\n        background-color: white; \/* Màu vàng khi hover *\/\n      }\n        .form-container-farealert input{\n            border: none;\n            font-style: normal;\n            font-weight: 400;\n            font-size: 12px;\n            line-height: 24px;\n            color: #7a7777;\n            outline: none\n        }\n        .form-container-farealert label{\n            font-style: normal;\n            font-weight: 400;\n            font-size: 12px;\n            line-height: 24px;\n            display: flex;\n            align-items: center;\n            color: #222222;\n        }\n        .form-container-farealert h2{\n            font-family: 'OpenSans-Regular';\n            font-style: normal;\n            font-weight: 400;\n            font-size: 16px;\n            line-height: 18px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: #006885;\n        }\n        .form-container-farealert h3{\n            color: #006885;\n            font-size: 12px;\n            margin : 0px !important;\n        }\n        .form-container-farealert h4{\n            font-style: normal;\n            font-weight: 400;\n            font-size: 14px;\n            line-height: 24px;\n            text-align: center;\n            color: #FFFFFF;\n        }\n        .form-container-farealert h1{\n            font-style: normal;\n            font-weight: 400;\n            font-size: 18px;\n            line-height: 24px;\n            text-align: center;\n            color: #FFFFFF;\n        }\n\n       .form-container-farealert p{\n            width: 174px;\n            font-style: normal;\n            font-weight: 400;\n            font-size: 12px;\n            line-height: 20px;\n            display: flex;\n            align-items: center;\n            text-align: center;\n            color: #E7E7E7;\n        }\n\n        .input-field-sector,\n        .input-field-date{\n            box-sizing: border-box;\n            display: flex;\n            flex-direction: row;\n            align-items: center;\n            padding: 0px 0px 0px 5px;\n            height: 32px;\n            background: #FFFFFF;\n            border-bottom: 1px solid #D1D3D6;\n            flex: none;\n            flex-grow: 0;\n            justify-content: space-between;\n        }\n        .input-field-radio {\n            border: none;\n            display: flex;\n            flex-direction: row;\n            \n            break-before: always;\n            margin: 5px 5px 15px 0;\n        }\n        .form-container-farealert button.signup{\n            display: flex;\n            padding: 5px;\n            width: 100px;\n            height: 28px;\n            background-color: #f4f9f5;\n            border: 3px solid #0C6F8C;\n            border-radius: 4px;\n            color: #0C6F8C;\n            font-size: 12px;  \n            letter-spacing: 1px;\n            justify-content: center;\n            float: right;\n            cursor: pointer;\n        }\n       .form-container-farealert button.signup:hover{\n            background-color: #0C6F8C;\n            color: #FFFFFF;\n        }\n       #form-container-farealert button.X{\n            background: none;\n            color: #222222;\n            border: none;\n            float: right;\n            cursor: pointer;\n            margin : 10px;\n        }\n        #sectors {\n          display: block; \/* Đảm bảo span chiếm toàn bộ chiều rộng *\/\n          padding: 85px 50px 85px 125px;\n          font-size: 16px; \/* Tăng kích thước chữ *\/\n          font-weight: bold; \/* Tùy chọn: làm chữ đậm hơn *\/\n          margin: 20px 0; \/* Tùy chọn: khoảng cách trên dưới để tạo sự thoáng *\/\n          color : #006885\n        }\n        #rectangle{\n            width: 60px;\n            height: 1px;\n            background: #FFFFFF;\n            flex: none;\n            flex-grow: 0;\n\n            transform: translateX(50px);\n        }\n\n        .form-container-farealert img{\n            max-width: 100%;\n            max-height: 100%\n        }\n        .popup-form-farealert {\n            display: none;\n            z-index: 999; \n            left: 0;\n            width: 100%; \n            height: 100%; \n          }\n        \n     .input-field-amount {\n      display: flex;\n      align-items: center;\n     }\n\n      .input-field-amount {\n    display: flex;\n    align-items: center;\n}\n\n.input-field-amount select {\n    border-left: none;\n    height: 33px;\n    font-style: normal;\n    font-weight: 400;\n    font-size: 14px;\n}\n\n.input-field-amount input {\n    flex-grow: 1;\n    height: 33px;\n    border: 1px solid #D1D3D6;  \n    border-left: none;\n    border-right: none;\n    padding: 0 5px;\n  width:50%;\n}\n\n.input-field-amount #amount {\n    width: 120px;\n}\n      \n\n.input-field-passenger {\n    width: 50px;\n    height: 33px;\n    border: 1px solid #D1D3D6;\n    border-left: none;\n    padding: 0 5px;\n    margin-left: 5px;\n}\n\n.input-field-amount label[for=\"passenger\"] {\n    margin-left: 5px; \n}\n      \n   .input-field-email input {\n      flex-grow: 1;\n      height: 33px;\n      padding: 0 5px;\n    }\n      \n   .input-field-phone {\n        display: flex;\n        align-items: center;\n      }\n .input-field-phone select {\n      border-left: none;\n       height: 33px;\n      font-style: normal;\n      font-weight: 400;\n      font-size: 12px;\n       max-width : 150px;\n    }\n\n  .input-field-phone input {\n    flex-grow: 1;\n    border: 1px solid #D1D3D6;\n    border-left: none;\n    border-right: none;\n    height: 33px;\n    padding: 0 5px;\n  }\n  .terms-text {\n    font-size: 10px; \/* Kích thước chữ *\/\n    height: 50px;\n    width:100%;\n    color: #555; \/* Màu chữ *\/\n    margin-left: 5px;\n}\n\n      .input-date {\n        max-width : 133px;\n      }\n      \n.terms-text a {\n    color: #0066cc;\n    text-decoration: none;\n    font-weight: bold; \n  white-space: nowrap;\n}\n\n.terms-text a:hover {\n    text-decoration: underline; \n}\n      \n      \/* rung chuông *\/\n      \n @keyframes bell-shake {\n  0% { transform: rotate(0); }\n  25% { transform: rotate(15deg); }\n  50% { transform: rotate(0); }\n  75% { transform: rotate(-15deg); }\n  100% { transform: rotate(0); }\n}\n      \n.bell-icon {\n  display: inline-block;\n  animation: bell-shake 0.5s ease-in-out infinite; \/* Chạy hiệu ứng rung *\/\n  margin-right : 5px;\n}\n      \n @media (max-width: 768px), (max-height: 500px)  {\n    #button-fare-alert {\n        display: none;\n    }\n}\n\n    \u003C\/style\u003E\n    \u003Cbutton class=\"custom-button\" id=\"button-fare-alert\"\u003E\n       \u003Ci class=\"fas fa-bell bell-icon\"\u003E\u003C\/i\u003E Báo giá tốt\u003C\/button\u003E\n\u003Cdiv id=\"form-container-farealert\" class=\"form-container-farealert\" style=\"position: relative;\"\u003E\n    \u003Cdiv id=\"overlay\" style=\"display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5); z-index:1;\"\u003E\u003C\/div\u003E\n\u003Cdiv class=\"popup-form-farealert\" id=\"popup-form\"\u003E\n  \u003Cdiv class=\"container-gms-farealert\"\u003E\n\t\u003Cdiv class=\"left-panel\"\u003E\n\t\t\u003Cdiv class=\"left-panel-content\"\u003E\n\t\t\t\u003Cdiv class=\"vietnamairlines-logo\"\u003E\n              \u003Cimg src=\"https:\/\/www.vietnamairlines.com\/~\/media\/Images\/VNANew\/Home\/Logo%20Header\/logovnachutrang.png\" alt=\"Vietnam Airlines Logo\" style=\"max-width: 100%; height: auto;\"\u003E\n\t\t\t\u003C\/div\u003E\t\t\t\n\t\t\t\u003Cdiv id=\"rectangle\"\u003E\u003C\/div\u003E\n\t\t\t\u003Ch4 class=\"title-thong-bao\" id=\"title-thong-bao\"\u003EThông báo giá tốt!\u003C\/h4\u003E\n\t\t\t\u003Cp id=\"mo-ta-thong-bao\"\u003ECập nhật giá vé máy bay tốt nhất cùng Vietnam Airlines! Quý khách vui lòng điền thông tin tại đây để trở thành người đầu tiên nhận thông báo khi có giá vé ưu đãi nhé!\u003C\/p\u003E\n\t\t\t\u003Cdiv id=\"rectangle\"\u003E\u003C\/div\u003E\n\t\t\u003C\/div\u003E\n\t\u003C\/div\u003E\n\t\u003Cdiv class=\"right-panel\"\u003E\n      \u003Cbutton class=\"X\" id=\"close\"\u003E\n        \u003Ci class=\"cross-icon refx-icon-cross\"\u003E\u003C\/i\u003E\n        \u003C\/button\u003E\n\t\t\u003Cform id=\"myForm\" method=\"POST\" class=\"form-alert\"\u003E\n\t\t\t\u003Cdiv class=\"input-field input-field-sector\"\u003E\n\t\t\t\t\u003Cinput type=\"text\" placeholder=\"\" name=\"depart\" disabled id=\"depart\"\u003E\n\t\t\t\t\u003Ch3 id=\"roundtrip\"\u003E↔\u003C\/h3\u003E\n                \u003Ch3 id=\"oneway\"\u003E→\u003C\/h3\u003E\n\t\t\t\t\u003Cinput type=\"text\" placeholder=\"\" name=\"des\" disabled id=\"des\"\u003E\n\t\t\t\u003C\/div\u003E\n             \u003Cinput type=\"hidden\" name=\"departureCode\" id=\"departureCode\"\u003E\n             \u003Cinput type=\"hidden\" name=\"returnCode\" id=\"returnCode\"\u003E\n             \u003Cinput type=\"hidden\" name=\"sectorDes\" id=\"sectorDes\"\u003E\n              \u003Cinput type=\"hidden\" name=\"tripType\" id=\"tripType\"\u003E\n\t\t\t\u003Cdiv class=\"input-field\"\u003E\n                 \u003Clabel for=\"departureDate\" style=\"min-width:92px\" id=\"label-departureDate\"\u003ENgày đi:\u003C\/label\u003E\n\t\t\t\t \u003Cinput type=\"text\" class=\"input-date\" name=\"departureDate\" placeholder=\"dd\/mm\/yyyy\" id=\"departureDate\"\u003E\n                 \u003Clabel for=\"returnDate\" id=\"label-returnDate\" style=\"min-width:70px\"\u003ENgày về:\u003C\/label\u003E\n\t\t\t\t \u003Cinput type=\"text\" class=\"input-date\" name=\"returnDate\" id=\"returnDate\" placeholder=\"dd\/mm\/yyyy\"\u003E\n\t\t\t\u003C\/div\u003E\n\t\t\t\u003Cdiv class=\"input-field input-field-amount\"\u003E\n              \u003Clabel for=\"amount\" id=\"budget\"\u003ENgân sách dự kiến:\u003C\/label\u003E\n                \u003Cselect id=\"currency\" disabled name=\"currency\"\u003E\n                  \u003Coption value=\"VND\"\u003EVND\u003C\/option\u003E\n                  \u003Coption value=\"USD\"\u003EUSD\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EEUR\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003ETHB\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003ETWD\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003ESGD\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003ESEK\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003ENOK\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EMYR\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EMOP\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EKRW\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EJPY\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EIDR\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EHKD\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EGBP\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EDKK\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003ECHF\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003ECNY\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003ECAD\u003C\/option\u003E\n                  \u003Coption value=\"EUR\"\u003EAUD\u003C\/option\u003E\n                \u003C\/select\u003E\n\t\t\t\t\u003Cinput type=\"text\" name=\"amount\" placeholder=\"1,000,000\" id=\"amount\"\u003E\u003Clabel for=\"passenger\" id=\"passenger\"\u003E\/khách\u003C\/label\u003E\n\t\t\t\u003C\/div\u003E\n\t\t\t\u003Cdiv class=\"input-field input-field-amount\"\u003E\n\t\t\t\t\u003Clabel for=\"passengerName\" id=\"passengerName\"\u003EHọ và tên:\u003C\/label\u003E\n\t\t\t\t\u003Cinput type=\"text\" name=\"passengerName\" placeholder=\"Nguyen Van A\" id=\"passengerName\"\u003E\n\t\t\t\u003C\/div\u003E\n\t\t\t\u003Cdiv class=\"input-field input-field-amount\"\u003E\n\t\t\t\t\u003Clabel for=\"email\"\u003EEmail:\u003C\/label\u003E\n\t\t\t\t\u003Cinput type=\"text\" name=\"email\" placeholder=\"abc@gmail.com\" id=\"email\"\u003E\n\t\t\t\u003C\/div\u003E\n\t\t\t\u003Cdiv class=\"input-field input-field-phone\"\u003E\n                \u003Clabel for=\"phone\" id=\"phone\"\u003ESố điện thoại:\u003C\/label\u003E\n                \u003Cselect id=\"countryCallingCode\" disabled name=\"countryCallingCode\"\u003E\n                \u003C\/select\u003E\n\t\t\t\t\u003Cinput type=\"text\" name=\"phone\" placeholder=\"0987654321\" id=\"phone\"\u003E\n\t\t\t\u003C\/div\u003E\n           \u003Cdiv class=\"terms-text\" id=\"terms-text-vi\"\u003E\n    Bằng việc ấn nút \u0026quot;Đăng ký\u0026quot;, Quý khách xác nhận đã đọc và đồng ý với\u003Ca href=\"https:\/\/www.vietnamairlines.com\/vn\/vi\/legal\/terms-and-conditions\" target=\"_blank\"\u003E Điều khoản sử dụng \u003C\/a\u003Evà \u003Ca href=\"https:\/\/www.vietnamairlines.com\/vn\/vi\/legal\/privacy-policy\" target=\"_blank\"\u003EChính sách bảo mật thông tin cá nhân\u003C\/a\u003E của Vietnam Airlines.\n\u003C\/div\u003E\n\u003Cdiv class=\"terms-text\" id=\"terms-text-en\"\u003E\n    By clicking the Submit button, you confirm that you have read and agree to the\u003Ca href=\"https:\/\/www.vietnamairlines.com\/vn\/en\/legal\/terms-and-conditions\" target=\"_blank\"\u003E Terms of Use\u003C\/a\u003E and\u003Ca href=\"https:\/\/www.vietnamairlines.com\/vn\/en\/legal\/privacy-policy\" target=\"_blank\"\u003E Privacy Policy\u003C\/a\u003E of Vietnam Airlines.\n\u003C\/div\u003E\n\t\t\t\u003Cbutton type=\"submit\" class=\"signup\" id=\"signUp\"\u003EĐăng ký\u003C\/button\u003E\n\t\t\u003C\/form\u003E\n\t\u003C\/div\u003E                                                                                          \n  \u003C\/div\u003E\n\u003C\/div\u003E\n\u003C\/div\u003E\n\n\u003Cscript type=\"text\/gtmscript\"\u003Evar lang=getLanguage();flatpickr([\"#departureDate\"],{locale:lang==\"vi\"?\"vn\":\"en\",dateFormat:\"d\/m\/Y\",altInput:!0,altFormat:\"d\/m\/Y\",allowInput:!0,onReady:function(a,c,d){d.altInput.style.textAlign=\"center\"}});flatpickr([\"#returnDate\"],{locale:lang==\"vi\"?\"vn\":\"en\",dateFormat:\"d\/m\/Y\",altInput:!0,altFormat:\"d\/m\/Y\",allowInput:!0,onReady:function(a,c,d){d.altInput.style.textAlign=\"right\"}});updateFormLanguage(lang);var regionCode=getCookie(\"countryCodeRegion\");\nlang!=\"vi\"\u0026\u0026lang!=\"en\"||!regionCode||regionCode!=\"VN\"?document.getElementById(\"button-fare-alert\").style.display=\"none\":document.getElementById(\"button-fare-alert\").style.display=\"block\";var languageElement=document.querySelector(\".menu-title-underline\");\nif(languageElement){var observer=new MutationObserver(function(a,c){a.forEach(function(d){d.type==\"childList\"\u0026\u0026(d=languageElement.tex